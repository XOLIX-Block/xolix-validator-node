{
  "name": "xolix-validator-node",
  "version": "1.1.0-AegisMesh",
  "description": "XOLIX FLUID Blockchain Validator Node",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js",
      "default": "./dist/sdk/index.js"
    },
    "./sdk/typescript": {
      "types": "./dist/sdk/typescript/index.d.ts",
      "import": "./dist/sdk/typescript/index.js",
      "default": "./dist/sdk/typescript/index.js"
    }
  },
  "bin": {
    "fluid": "dist/cli/index.js",
    "xolix": "dist/cli/index.js"
  },
  "scripts": {
    "start": "node dist/node/start.js",
    "build": "tsc",
    "keygen": "node dist/cli/index.js validator:keygen",
    "status": "node dist/cli/index.js validator:list"
  },
  "keywords": [
    "blockchain",
    "evm",
    "xolix",
    "fluidscript",
    "xls",
    "qsc",
    "podi",
    "nextjs14"
  ],
  "author": "XOLIX FLUID Core Engineering Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "ts-node": "^10.9.2",
    "viem": "^2.7.15"
  }
}